{
  "name": "book-the-game-backend",
  "version": "4.0.0",
  "private": true,
  "description": "Book The Game REST API with PostgreSQL, Redis and Elasticsearch search",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "tsc -p tsconfig.json",
    "build:frontend": "npm --prefix frontend run build",
    "start": "node dist/src/server.js",
    "job:expire": "tsx src/jobs/runExpirationJob.ts",
    "search:create-index": "tsx src/search/scripts/createIndex.ts",
    "search:create-index:prod": "node dist/src/search/scripts/createIndex.js",
    "search:reindex": "tsx src/search/scripts/reindex.ts",
    "search:reindex:prod": "node dist/src/search/scripts/reindex.js",
    "search:rebuild": "tsx src/search/scripts/rebuildIndex.ts",
    "search:rebuild:prod": "node dist/src/search/scripts/rebuildIndex.js",
    "test": "jest --runInBand",
    "test:frontend": "npm --prefix frontend test",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:concurrency": "tsx tests/concurrency/reservation-concurrency.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests frontend/src frontend/vite.config.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:all": "npm run check && npm run test:frontend && npm run build && npm run build:frontend"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "redis": "^5.6.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.14",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "source-map": "^0.6.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.6",
    "tsx": "^4.20.3",
    "type-detect": "^4.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  }
}
