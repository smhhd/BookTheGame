NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/book_the_game
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=book_the_game_tickets_v1
ELASTICSEARCH_REQUEST_TIMEOUT_MS=2000
ELASTICSEARCH_REINDEX_BATCH_SIZE=500
SEARCH_FALLBACK_TO_POSTGRES=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
OTP_HASH_SECRET=replace-with-a-separate-32-character-secret
OTP_TTL_SECONDS=300
OTP_REQUEST_WINDOW_SECONDS=900
OTP_REQUEST_MAX=5
OTP_VERIFY_MAX_ATTEMPTS=5
EXPOSE_DEV_OTP=false
RESERVATION_TTL_MINUTES=10
EXPIRATION_JOB_CRON=*/1 * * * *
EXPIRATION_BATCH_SIZE=100
CACHE_LIST_TTL_SECONDS=300
CACHE_PROFILE_TTL_SECONDS=120
CACHE_TICKET_TTL_SECONDS=60
CACHE_SEARCH_TTL_SECONDS=30
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT=100kb
AUTH_RATE_LIMIT_MAX=30
LOG_LEVEL=info
